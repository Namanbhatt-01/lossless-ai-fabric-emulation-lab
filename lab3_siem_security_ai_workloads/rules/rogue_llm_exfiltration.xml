<!-- Custom Wazuh SIEM Detection Rules for AI Infrastructure -->
<group name="ai_security,llm_exfiltration,">
  <!-- Rule 100100: Detect unauthorized outbound connection to public LLM APIs -->
  <rule id="100100" level="10">
    <decoded_as>json</decoded_as>
    <field name="destination.domain">api.openai.com|api.anthropic.com|api.cohere.ai</field>
    <description>AI SecOps Alert: Direct outbound connection to external LLM API from restricted compute node</description>
    <mitre>
      <id>T1048</id>
    </mitre>
  </rule>

  <!-- Rule 100101: Detect anomalous token volume / data exfiltration burst -->
  <rule id="100101" level="12">
    <if_sid>100100</if_sid>
    <field name="http.response_body_bytes" type="pcre2">^([5-9][0-9]{5,}|[1-9][0-9]{6,})</field>
    <description>CRITICAL: High-volume LLM payload transfer (>500KB) detected indicating dataset/model exfiltration</description>
    <mitre>
      <id>T1041</id>
    </mitre>
  </rule>

  <!-- Rule 100102: Detect prompt injection evasion keywords in API query -->
  <rule id="100102" level="11">
    <decoded_as>json</decoded_as>
    <match>Ignore previous instructions|system override|DAN mode|reveal system prompt</match>
    <description>AI SecOps Alert: Adversarial Prompt Injection signature detected in LLM prompt payload</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>
</group>
